# Backend LLM : "mistral" (cloud, clé gratuite), "ollama" (local, sans clé)
# ou "anthropic" (Claude, cloud).
LLM_BACKEND=anthropic

# --- Anthropic / Claude (LLM_BACKEND=anthropic) ---
# Clé : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Modèle (défaut claude-opus-4-8). Pour réduire le coût sur un agent à
# nombreux appels : claude-sonnet-4-6 ou claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Mistral (LLM_BACKEND=mistral) ---
# Clé gratuite (tier Experiment) : https://console.mistral.ai/
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Ollama (LLM_BACKEND=ollama) ---
# Prérequis : `ollama pull qwen2.5:3b`
OLLAMA_MODEL=qwen2.5:3b
